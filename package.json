{
  "name": "wisp-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Wisp — AI-Powered Contextual Viewing for Fire TV (Amazon Developer Hackathon 2026)",
  "motto": "A little more, when you need it.",
  "workspaces": [
    "ai-engine",
    "frontend",
    "backend",
    "cloudflare"
  ],
  "scripts": {
    "ai:playground": "npm --workspace=ai-engine run playground",
    "dev:backend": "npm --workspace=backend run start:dev",
    "dev:frontend": "npm --workspace=frontend run start",
    "dev:edge": "npm --workspace=cloudflare run dev",
    "build:backend": "npm --workspace=backend run build",
    "build:edge": "npm --workspace=cloudflare run build",
    "android:firetv": "npm --workspace=frontend run android",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "node --test \"testing/**/*.test.ts\"",
    "test:ai": "node --test \"testing/ai-integration/*.test.ts\"",
    "test:backend": "node --test \"testing/backend/*.test.ts\"",
    "test:frontend": "node --test \"testing/frontend/*.test.ts\"",
    "test:database": "node --test \"testing/database/*.test.ts\"",
    "test:cloudflare": "node --test \"testing/cloudflare/*.test.ts\"",
    "test:e2e": "node --test \"testing/full-application/*.test.ts\"",
    "security:audit": "node security/runner.ts",
    "security:test": "node --test security/regression.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT"
}
