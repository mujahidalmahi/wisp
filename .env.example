# ============================================================================
# WISP — Root Environment Template
# Copy relevant variables into backend/.env, frontend/.env, or cloudflare/.dev.vars
# ============================================================================

# --- Application Environment ---
NODE_ENV=development
PORT=3000

# --- HTTP Security, CORS & Cryptographic Tokens ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000,http://127.0.0.1:3000,http://localhost:8081
CSRF_SECRET=your-secure-csrf-hmac-secret-min-32-chars
DEVICE_AUTH_SECRET=your-secure-device-auth-jwt-secret-min-32-chars
INTERNAL_OPERATOR_TOKEN=your-secure-internal-operator-token

# --- Supabase (Database & Auth) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI Provider Credentials (Backend Only — NEVER expose in Fire TV client) ---
# Routing priority: Groq (ultra-low latency) -> Gemini Flash -> OpenRouter -> Ollama (local dev)
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Cloudflare Edge Gateway & R2 Media CDN ---
CLOUDFLARE_EDGE_URL=https://wisp-edge.your-subdomain.workers.dev
CLOUDFLARE_R2_PUBLIC_URL=https://media.wisp-tv.dev

# --- Fire TV Client Configuration ---
WISP_API_BASE_URL=http://10.0.2.2:3000/api/v1
WISP_DEFAULT_PROFILE_MODE=quick_glance
