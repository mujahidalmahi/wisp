{
  "name": "@wisp/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comprehensive multi-layer testing suite for Wisp (Frontend, Backend, AI-Integration, Database, Cloudflare Edge, and Full-Application E2E)",
  "scripts": {
    "test": "node --test \"**/*.test.ts\"",
    "test:ai": "node --test \"ai-integration/*.test.ts\"",
    "test:backend": "node --test \"backend/*.test.ts\"",
    "test:frontend": "node --test \"frontend/*.test.ts\"",
    "test:database": "node --test \"database/*.test.ts\"",
    "test:cloudflare": "node --test \"cloudflare/*.test.ts\"",
    "test:e2e": "node --test \"full-application/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "typescript": "^5.6.2"
  }
}
